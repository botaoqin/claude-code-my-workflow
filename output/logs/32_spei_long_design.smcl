. * ===========================================================================
. * (b) Specification A: level-shift dummies on raw SPEI3_L
. *     Main cutoffs: D1 <=-1.5, D2 (-1.5,-1], W1 [1,1.5), W2 >=1.5,
. *     reference (-1,1).
. * ===========================================================================
. gen byte d1 = (SPEI3_L <= -1.5) if !missing(SPEI3_L)
{txt}
{com}. gen byte d2 = (SPEI3_L > -1.5 & SPEI3_L <= -1) if !missing(SPEI3_L)
{txt}
{com}. gen byte w1 = (SPEI3_L >= 1 & SPEI3_L < 1.5) if !missing(SPEI3_L)
{txt}
{com}. gen byte w2 = (SPEI3_L >= 1.5) if !missing(SPEI3_L)
{txt}
{com}. gen byte rf = (SPEI3_L > -1 & SPEI3_L < 1) if !missing(SPEI3_L)
{txt}
{com}. egen byte ncat = rowtotal(d1 d2 w1 w2 rf)
{txt}
{com}. assert ncat == 1 if !missing(SPEI3_L)
{txt}
{com}. 
. * Collapsed headline dummy (memo's collapse rule)
. gen byte drought = (SPEI3_L <= -1) if !missing(SPEI3_L)
{txt}
{com}. 
. * Alternative drought cutoffs: -2 / -1
. gen byte d1b = (SPEI3_L <= -2) if !missing(SPEI3_L)
{txt}
{com}. gen byte d2b = (SPEI3_L > -2 & SPEI3_L <= -1) if !missing(SPEI3_L)
{txt}
{com}. 
. * SPEI1 and SPEI6 category versions
. foreach v in SPEI1_L SPEI6_L {c -(}
{txt}  2{com}.     gen byte `v'_d1 = (`v' <= -1.5) if !missing(`v')
{txt}  3{com}.     gen byte `v'_d2 = (`v' > -1.5 & `v' <= -1) if !missing(`v')
{txt}  4{com}.     gen byte `v'_w1 = (`v' >= 1 & `v' < 1.5) if !missing(`v')
{txt}  5{com}.     gen byte `v'_w2 = (`v' >= 1.5) if !missing(`v')
{txt}  6{com}.     gen byte `v'_rf = (`v' > -1 & `v' < 1) if !missing(`v')
{txt}  7{com}. {c )-}
{txt}
{com}. 
. gen d1_x_h    = d1 * HydroShare_z
