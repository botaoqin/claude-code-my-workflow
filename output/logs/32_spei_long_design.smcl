. * Export the nine bin coefficients for the Python diagnostic figure.
. matrix B = J(9, 3, .)
{txt}
{com}. local binvals "1 2 3 4 6 7 8 9 10"
{txt}
{com}. local binno = 0
{txt}
{com}. foreach v in b1 b2 b3 b4 b6 b7 b8 b9 b10 {c -(}
{txt}  2{com}.     local ++binno
{txt}  3{com}.     local bid : word `binno' of `binvals'
{txt}  4{com}.     local bb = _b[`v']
{txt}  5{com}.     local ss = _se[`v']
{txt}  6{com}.     matrix B[`binno', 1] = `bid'
{txt}  7{com}.     matrix B[`binno', 2] = `bb'
{txt}  8{com}.     matrix B[`binno', 3] = `ss'
{txt}  9{com}. {c )-}
{txt}
{com}. matrix colnames B = bin b se
{txt}
{com}. preserve
{txt}
{com}.     clear
{txt}
{com}.     svmat B, names(col)
