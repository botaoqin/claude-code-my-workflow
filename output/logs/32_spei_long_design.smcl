. esttab A1 A2 A3 A4 A5 A6 using "output/tables/spei_long_specA.tex", replace ///
>     booktabs label b(4) se(4) star(* 0.10 ** 0.05 *** 0.01) ///
>     keep(d1 d2 w1 w2 d1_x_h d2_x_h w1_x_h w2_x_h drought dr_x_h ///
>          d1b d2b d1b_x_h d2b_x_h ///
>          SPEI1_L_d1 SPEI1_L_d2 SPEI1_L_w1 SPEI1_L_w2 ///
>          SPEI1_L_d1_x_h SPEI1_L_d2_x_h SPEI1_L_w1_x_h SPEI1_L_w2_x_h ///
>          SPEI6_L_d1 SPEI6_L_d2 SPEI6_L_w1 SPEI6_L_w2 ///
>          SPEI6_L_d1_x_h SPEI6_L_d2_x_h SPEI6_L_w1_x_h SPEI6_L_w2_x_h) ///
>     order(d1 d2 w1 w2 drought d1b d2b ///
>           SPEI1_L_d1 SPEI1_L_d2 SPEI1_L_w1 SPEI1_L_w2 ///
>           SPEI6_L_d1 SPEI6_L_d2 SPEI6_L_w1 SPEI6_L_w2 ///
>           d1_x_h d2_x_h w1_x_h w2_x_h dr_x_h d1b_x_h d2b_x_h ///
>           SPEI1_L_d1_x_h SPEI1_L_d2_x_h SPEI1_L_w1_x_h SPEI1_L_w2_x_h ///
>           SPEI6_L_d1_x_h SPEI6_L_d2_x_h SPEI6_L_w1_x_h SPEI6_L_w2_x_h) ///
>     mtitles("No int." "Cutoffs -1.5/-1" "Collapsed" "Cutoffs -2/-1" ///
>             "SPEI1" "SPEI6") ///
>     stats(N r2_a, fmt(%9.0fc %9.3f) labels("Observations" "Adj. R-squared")) ///
>     nonotes ///
>     addnotes("SEs in parentheses, clustered at province level (29 clusters)." ///
>              "DV: g_IndVA = NBS published single-month real YoY growth (fraction)." ///
>              "SPEI*_L: long-baseline (1940-2025) log-logistic SPEI, raw standardized units." ///
>              "Dummies use the raw index; omitted category is -1 < SPEI < 1." ///
>              "HydroShare is standardised within the estimation sample." ///
>              "FE: province + year-month. Sample: Mar-Dec 2002-2026." ///
>              "* p<0.10, ** p<0.05, *** p<0.01.")
{res}{txt}(output written to {browse  `"output/tables/spei_long_specA.tex"'})

{com}. 
. * ===========================================================================
. * (c) Specification B: Eyer-Wichman slope-by-bin (six bins) and linear spline
. *     Knots: -1.5, -1, 0, 1, 1.5. Each beta is the effect of a one-unit SPEI
. *     change within that range.
. * ===========================================================================
. foreach v in SPEI1_L SPEI3_L SPEI6_L {c -(}
{txt}  2{com}.     gen byte `v'_e1 = (`v' <= -1.5) if !missing(`v')
{txt}  3{com}.     gen byte `v'_e2 = (`v' > -1.5 & `v' <= -1) if !missing(`v')
{txt}  4{com}.     gen byte `v'_e3 = (`v' > -1 & `v' <= 0) if !missing(`v')
{txt}  5{com}.     gen byte `v'_e4 = (`v' > 0 & `v' <= 1) if !missing(`v')
{txt}  6{com}.     gen byte `v'_e5 = (`v' > 1 & `v' <= 1.5) if !missing(`v')
{txt}  7{com}.     gen byte `v'_e6 = (`v' > 1.5) if !missing(`v')
{txt}  8{com}.     egen byte `v'_ncat = rowtotal(`v'_e1 `v'_e2 `v'_e3 `v'_e4 `v'_e5 `v'_e6)
{txt}  9{com}.     assert `v'_ncat == 1 if !missing(`v')
{txt} 10{com}.     forvalues j = 1/6 {c -(}
{txt} 11{com}.         gen `v'_x`j' = `v' * `v'_e`j'
{txt} 12{com}.         gen `v'_x`j'_h = `v' * `v'_e`j' * HydroShare_z
{txt} 13{com}.     {c )-}
{txt} 14{com}. {c )-}
{txt}
{com}. 
. label var SPEI3_L_x1 "SPEI3 $\times$ 1(SPEI3 $\leq -1.5$)"
{txt}
{com}. label var SPEI3_L_x2 "SPEI3 $\times$ 1($-1.5 <$ SPEI3 $\leq -1$)"
{txt}
{com}. label var SPEI3_L_x3 "SPEI3 $\times$ 1($-1 <$ SPEI3 $\leq 0$)"
{txt}
{com}. label var SPEI3_L_x4 "SPEI3 $\times$ 1($0 <$ SPEI3 $\leq 1$)"
{txt}
{com}. label var SPEI3_L_x5 "SPEI3 $\times$ 1($1 <$ SPEI3 $\leq 1.5$)"
{txt}
{com}. label var SPEI3_L_x6 "SPEI3 $\times$ 1(SPEI3 $> 1.5$)"
{txt}
{com}. label var SPEI3_L_x1_h "SPEI3 $\times$ 1($\leq -1.5$) $\times$ Hydro"
{txt}
{com}. label var SPEI3_L_x2_h "SPEI3 $\times$ 1($-1.5,-1$] $\times$ Hydro"
{txt}
{com}. label var SPEI3_L_x3_h "SPEI3 $\times$ 1($-1,0$] $\times$ Hydro"
{txt}
{com}. label var SPEI3_L_x4_h "SPEI3 $\times$ 1($0,1$] $\times$ Hydro"
{txt}
{com}. label var SPEI3_L_x5_h "SPEI3 $\times$ 1($1,1.5$] $\times$ Hydro"
{txt}
{com}. label var SPEI3_L_x6_h "SPEI3 $\times$ 1($> 1.5$) $\times$ Hydro"
{txt}
{com}. 
. foreach v in SPEI1_L SPEI6_L {c -(}
{txt}  2{com}.     local nm : subinstr local v "_L" "", all
{txt}  3{com}.     label var `v'_x1 "`nm' $\times$ 1(`nm' $\leq -1.5$)"
{txt}  4{com}.     label var `v'_x2 "`nm' $\times$ 1($-1.5 <$ `nm' $\leq -1$)"
{txt}  5{com}.     label var `v'_x3 "`nm' $\times$ 1($-1 <$ `nm' $\leq 0$)"
{txt}  6{com}.     label var `v'_x4 "`nm' $\times$ 1($0 <$ `nm' $\leq 1$)"
{txt}  7{com}.     label var `v'_x5 "`nm' $\times$ 1($1 <$ `nm' $\leq 1.5$)"
{txt}  8{com}.     label var `v'_x6 "`nm' $\times$ 1(`nm' $> 1.5$)"
{txt}  9{com}.     label var `v'_x1_h "`nm' $\times$ 1($\leq -1.5$) $\times$ Hydro"
{txt} 10{com}.     label var `v'_x2_h "`nm' $\times$ 1($-1.5,-1$] $\times$ Hydro"
{txt} 11{com}.     label var `v'_x3_h "`nm' $\times$ 1($-1,0$] $\times$ Hydro"
{txt} 12{com}.     label var `v'_x4_h "`nm' $\times$ 1($0,1$] $\times$ Hydro"
{txt} 13{com}.     label var `v'_x5_h "`nm' $\times$ 1($1,1.5$] $\times$ Hydro"
{txt} 14{com}.     label var `v'_x6_h "`nm' $\times$ 1($> 1.5$) $\times$ Hydro"
{txt} 15{com}. {c )-}
{txt}
{com}. 
. eststo clear
{txt}
{com}. 
