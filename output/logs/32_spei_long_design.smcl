{p_end}

{com}.     export delimited scale segment hydro b se ///
>         using "output/intermediates/spei_long_spline.csv", replace
{res}{txt}(note: file output/intermediates/spei_long_spline.csv not found)
{txt}file output/intermediates/spei_long_spline.csv saved

{com}. restore
{txt}
{com}. 
. * ===========================================================================
. * (d) Reference-period and PET comparison on one collapsed-dummy spec
. *     Variants: old SPEI3 (2000-2026 fit), SPEI3_L (1940-2025 fit),
. *     prefit (1940-2001), WMO (1961-2020), calendar-month, Thornthwaite.
. *     Each variant has its own z-score and heat x SPEI control.
. * ===========================================================================
. eststo clear
{txt}
{com}. local names "old L pre wmo cm th"
{txt}
{com}. local vars  "SPEI3 SPEI3_L SPEI3_L_prefit SPEI3_L_wmo SPEI3_L_cm SPEI3_L_th"
{txt}
{com}. local k = 0
{txt}
{com}. foreach n of local names {c -(}
{txt}  2{com}.     local ++k
{txt}  3{com}.     local v : word `k' of `vars'
{txt}  4{com}.     egen z_`n' = std(`v')
{txt}  5{com}.     gen byte dr_`n' = (`v' <= -1) if !missing(`v')
{txt}  6{com}.     gen drh_`n' = dr_`n' * HydroShare_z
{txt}  7{com}.     gen hx_`n' = heat_z * z_`n'
{txt}  8{com}.     label var dr_`n' "Drought: SPEI $\leq -1$"
{txt}  9{com}.     label var drh_`n' "Drought $\times$ HydroShare(z)"
{txt} 10{com}.     reghdfe g_IndVA dr_`n' drh_`n' heat_z hx_`n' precip_sum, ///
>         absorb(prov_id ym) vce(cluster prov_id)
{txt} 11{com}.     eststo V_`n'
{txt} 12{com}. {c )-}
