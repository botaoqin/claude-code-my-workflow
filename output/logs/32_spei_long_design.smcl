. * case(preserve): import delimited lowercases header names by default.
. import delimited "output/intermediates/real_panel_spei_long.csv", clear case(preserve)
{res}{text}(66 vars, 9,858 obs)

{com}. 
. * --- Identical estimation sample to 07 / 31 --------------------------------
. keep if !missing(g_IndVA, SPEI3_z, heat_z, HydroShare_z, ///
>                  hydro_gen, thermal_gen, total_gen)
{txt}(2,597 observations deleted)

{com}. drop if inlist(month, 1, 2)
{txt}(286 observations deleted)

{com}. drop if year < 2002
{txt}(0 observations deleted)

{com}. 
. count
  {res}6,975
{txt}
{com}. assert r(N) == 6975
{txt}
{com}. assert inrange(month, 3, 12)
{txt}
{com}. assert inrange(year, 2002, 2026)
{txt}
{com}. assert !missing(SPEI3_L)
{txt}
{com}. 
. egen byte tag_prov = tag(prov_id)
{txt}
{com}. count if tag_prov
  {res}29
{txt}
{com}. assert r(N) == 29
{txt}
{com}. drop tag_prov
{txt}
{com}. 
. * --- Sample-standardised versions of the long-baseline series --------------
. egen SPEI1_L_z = std(SPEI1_L)
{txt}
{com}. egen SPEI3_L_z = std(SPEI3_L)
{txt}
{com}. egen SPEI6_L_z = std(SPEI6_L)
{txt}
{com}. gen heat_x_spei_L = heat_z * SPEI3_L_z
{txt}
{com}. 
. * --- Mechanism outcomes (as in 12_decompose_generation.do) -----------------
. gen ln_hydro   = log(hydro_gen + 1)
{txt}
{com}. gen ln_thermal = log(thermal_gen + 1)
{txt}
{com}. gen ln_total   = log(total_gen + 1)
{txt}
{com}. 
. * ===========================================================================
. * (a) 0.5-SD bin diagnostic on raw SPEI3_L
. *     Bins: <=-2, (-2,-1.5], ..., (1.5,2], >2; reference (-0.5,0].
. * ===========================================================================
. gen byte spbin = .
{txt}(6,975 missing values generated)

{com}. replace spbin = 1  if SPEI3_L <= -2
{txt}(306 real changes made)

{com}. replace spbin = 2  if SPEI3_L > -2   & SPEI3_L <= -1.5
{txt}(368 real changes made)

{com}. replace spbin = 3  if SPEI3_L > -1.5 & SPEI3_L <= -1
{txt}(747 real changes made)

{com}. replace spbin = 4  if SPEI3_L > -1   & SPEI3_L <= -0.5
{txt}(1,099 real changes made)

{com}. replace spbin = 5  if SPEI3_L > -0.5 & SPEI3_L <= 0
{txt}(1,307 real changes made)

{com}. replace spbin = 6  if SPEI3_L > 0    & SPEI3_L <= 0.5
{txt}(1,246 real changes made)

{com}. replace spbin = 7  if SPEI3_L > 0.5  & SPEI3_L <= 1
{txt}(1,170 real changes made)

{com}. replace spbin = 8  if SPEI3_L > 1    & SPEI3_L <= 1.5
{txt}(586 real changes made)

{com}. replace spbin = 9  if SPEI3_L > 1.5  & SPEI3_L <= 2
{txt}(139 real changes made)

{com}. replace spbin = 10 if SPEI3_L > 2
{txt}(7 real changes made)

{com}. label define spbin 1 "<= -2" 2 "(-2,-1.5]" 3 "(-1.5,-1]" 4 "(-1,-.5]" ///
>                    5 "(-.5,0] (ref)" 6 "(0,.5]" 7 "(.5,1]" 8 "(1,1.5]" ///
>                    9 "(1.5,2]" 10 "> 2"
{txt}
{com}. label values spbin spbin
{txt}
{com}. tab spbin, missing

