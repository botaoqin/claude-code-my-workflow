{com}. eststo B6
{txt}
{com}. 
. esttab B1 B2 B3 B4 B5 B6 using "output/tables/spei_long_specB.tex", replace ///
>     booktabs label b(4) se(4) star(* 0.10 ** 0.05 *** 0.01) ///
>     keep(SPEI3_L_x1 SPEI3_L_x2 SPEI3_L_x3 SPEI3_L_x4 SPEI3_L_x5 SPEI3_L_x6 ///
>          SPEI3_L_x1_h SPEI3_L_x2_h SPEI3_L_x3_h SPEI3_L_x4_h ///
>          SPEI3_L_x5_h SPEI3_L_x6_h ///
>          SPEI1_L_x1 SPEI1_L_x2 SPEI1_L_x3 SPEI1_L_x4 SPEI1_L_x5 SPEI1_L_x6 ///
>          SPEI1_L_x1_h SPEI1_L_x2_h SPEI1_L_x3_h SPEI1_L_x4_h ///
>          SPEI1_L_x5_h SPEI1_L_x6_h ///
>          SPEI6_L_x1 SPEI6_L_x2 SPEI6_L_x3 SPEI6_L_x4 SPEI6_L_x5 SPEI6_L_x6 ///
>          SPEI6_L_x1_h SPEI6_L_x2_h SPEI6_L_x3_h SPEI6_L_x4_h ///
>          SPEI6_L_x5_h SPEI6_L_x6_h) ///
>     mtitles("SPEI3" "SPEI3 $\times$ Hydro" "SPEI1" "SPEI1 $\times$ Hydro" ///
>             "SPEI6" "SPEI6 $\times$ Hydro") ///
>     stats(N r2_a, fmt(%9.0fc %9.3f) labels("Observations" "Adj. R-squared")) ///
>     nonotes ///
>     addnotes("SEs in parentheses, clustered at province level (29 clusters)." ///
>              "DV: g_IndVA. Each coefficient is the slope of the one-unit SPEI change inside its bin." ///
>              "Bins: <=-1.5, (-1.5,-1], (-1,0], (0,1], (1,1.5], >1.5; no separate bin dummies (Eyer-Wichman form)." ///
>              "HydroShare is standardised; interaction slopes are the extra slope per one SD of baseline hydro share." ///
>              "FE: province + year-month. Sample: Mar-Dec 2002-2026." ///
>              "* p<0.10, ** p<0.05, *** p<0.01.")
{res}{txt}(output written to {browse  `"output/tables/spei_long_specB.tex"'})

{com}. 
. * --- Linear spline with the same knots (preferred form if it differs) ------
. * Basis: x, (x+1.5)+, (x+1)+, (x)+, (x-1)+, (x-1.5)+; segment slopes are sums
. * of the basis coefficients up to the segment's upper knot.
. matrix S = J(36, 5, .)
{txt}
{com}. local row = 0
{txt}
{com}. 
. foreach sc of numlist 1 3 6 {c -(}
{txt}  2{com}.     gen bx_0   = SPEI`sc'_L
{txt}  3{com}.     gen bx_15  = max(SPEI`sc'_L + 1.5, 0)
{txt}  4{com}.     gen bx_1   = max(SPEI`sc'_L + 1, 0)
{txt}  5{com}.     gen bx_00  = max(SPEI`sc'_L, 0)
{txt}  6{com}.     gen bx_10  = max(SPEI`sc'_L - 1, 0)
{txt}  7{com}.     gen bx_115 = max(SPEI`sc'_L - 1.5, 0)
{txt}  8{com}.     gen hbx_0   = bx_0   * HydroShare_z
{txt}  9{com}.     gen hbx_15  = bx_15  * HydroShare_z
{txt} 10{com}.     gen hbx_1   = bx_1   * HydroShare_z
{txt} 11{com}.     gen hbx_00  = bx_00  * HydroShare_z
{txt} 12{com}.     gen hbx_10  = bx_10  * HydroShare_z
{txt} 13{com}.     gen hbx_115 = bx_115 * HydroShare_z
{txt} 14{com}. 
.     reghdfe g_IndVA bx_0 bx_15 bx_1 bx_00 bx_10 bx_115 ///
>         hbx_0 hbx_15 hbx_1 hbx_00 hbx_10 hbx_115 ///
>         heat_z heat_x_spei_L precip_sum, absorb(prov_id ym) vce(cluster prov_id)
{txt} 15{com}.     estimates store spl`sc'
{txt} 16{com}. 
.     local e0 "bx_0"
{txt} 17{com}.     local e1 "bx_0 + bx_15"
{txt} 18{com}.     local e2 "bx_0 + bx_15 + bx_1"
{txt} 19{com}.     local e3 "bx_0 + bx_15 + bx_1 + bx_00"
{txt} 20{com}.     local e4 "bx_0 + bx_15 + bx_1 + bx_00 + bx_10"
{txt} 21{com}.     local e5 "bx_0 + bx_15 + bx_1 + bx_00 + bx_10 + bx_115"
{txt} 22{com}.     local h0 "hbx_0"
{txt} 23{com}.     local h1 "hbx_0 + hbx_15"
{txt} 24{com}.     local h2 "hbx_0 + hbx_15 + hbx_1"
{txt} 25{com}.     local h3 "hbx_0 + hbx_15 + hbx_1 + hbx_00"
{txt} 26{com}.     local h4 "hbx_0 + hbx_15 + hbx_1 + hbx_00 + hbx_10"
{txt} 27{com}.     local h5 "hbx_0 + hbx_15 + hbx_1 + hbx_00 + hbx_10 + hbx_115"
{txt} 28{com}. 
.     forvalues j = 0/5 {c -(}
{txt} 29{com}.         local row = `row' + 1
{txt} 30{com}.         matrix S[`row', 1] = `sc'
{txt} 31{com}.         matrix S[`row', 2] = `j' + 1
{txt} 32{com}.         matrix S[`row', 3] = 0
{txt} 33{com}.         lincom `e`j''
{txt} 34{com}.         matrix S[`row', 4] = r(estimate)
{txt} 35{com}.         matrix S[`row', 5] = r(se)
{txt} 36{com}.         local row = `row' + 1
{txt} 37{com}.         matrix S[`row', 1] = `sc'
{txt} 38{com}.         matrix S[`row', 2] = `j' + 1
{txt} 39{com}.         matrix S[`row', 3] = 1
{txt} 40{com}.         lincom `e`j'' + `h`j''
{txt} 41{com}.         matrix S[`row', 4] = r(estimate)
{txt} 42{com}.         matrix S[`row', 5] = r(se)
{txt} 43{com}.     {c )-}
{txt} 44{com}.     drop bx_0 bx_15 bx_1 bx_00 bx_10 bx_115 hbx_0 hbx_15 hbx_1 hbx_00 hbx_10 hbx_115
{txt} 45{com}. {c )-}
