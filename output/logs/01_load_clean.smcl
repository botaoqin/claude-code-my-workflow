{com}. 
. import delimited "output/intermediates/synthetic_panel.csv", clear
{res}{text}(7 vars, 620 obs)

{com}. assert inrange(province, 1, 31)
{txt}
{com}. assert inrange(year, 2000, 2019)
{txt}
{com}. assert !missing(h, d, p, ln_y, y_level)
{txt}
{com}. count
  {res}620
{txt}
{com}. assert r(N) == 620
{txt}
{com}. 
. label var province "Province id"
{txt}
{com}. label var year     "Year"
{txt}
{com}. label var d        "Drought index (std.)"
{txt}
{com}. label var p        "Precip. anomaly (std.)"
{txt}
{com}. label var h        "Hydro share (0-1)"
{txt}
{com}. label var ln_y     "Log industrial output"
{txt}
{com}. label var y_level  "Industrial output (index)"
{txt}
{com}. 
. gen d2 = d^2
{txt}
{com}. label var d2 "Drought index squared"
{txt}
{com}. 
. xtset province year
{res}{txt}{col 8}panel variable:  {res}province (strongly balanced)
{txt}{col 9}time variable:  {res}{col 25}year, 2000 to 2019
{txt}{col 17}delta:  {res}1 unit
{txt}
{com}. save "output/intermediates/panel.dta", replace
{txt}(note: file output/intermediates/panel.dta not found)
file output/intermediates/panel.dta saved

{com}. 
